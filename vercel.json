{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "about.html", "use": "@vercel/static" },
    { "src": "faq.html", "use": "@vercel/static" },
    { "src": "keratin-or-repair.html", "use": "@vercel/static" },
    { "src": "services.html", "use": "@vercel/static" },
    { "src": "service-categories.html", "use": "@vercel/static" },
    { "src": "rebonding-vs-digital-perm.html", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "llms.txt", "use": "@vercel/static" },
    { "src": "llms-full.txt", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "apple-icon.png", "use": "@vercel/static" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/keratin-or-repair.html", "destination": "/keratin-or-repair", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/service-categories.html", "destination": "/service-categories", "permanent": true },
    { "source": "/rebonding-vs-digital-perm.html", "destination": "/rebonding-vs-digital-perm", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/faq/", "destination": "/faq", "permanent": true },
    { "source": "/services/", "destination": "/services", "permanent": true },
    { "source": "/service-categories/", "destination": "/service-categories", "permanent": true },
    { "source": "/public/sitemap.xml", "destination": "/sitemap.xml", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/keratin-or-repair", "destination": "/keratin-or-repair.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/service-categories", "destination": "/service-categories.html" },
    { "source": "/rebonding-vs-digital-perm", "destination": "/rebonding-vs-digital-perm.html" },
    { "source": "/favicon.ico", "destination": "/public/favicon-32.png" },
    { "source": "/(index)?", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
